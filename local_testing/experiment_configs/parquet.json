{
  "runId": "example-kmeans-parquet",
  "profile": "local",
  "dataset": {
    "type": "parquet",
    "params": {
      "path": "/path/to/data.parquet",
      "featureColumns": ["x", "y", "z"],
      "repartition": 32
    }
  },
  "algorithm": {
    "name": "kmeans",
    "params": {
      "k": 5,
      "maxIter": 50,
      "distance": "euclidean",
      "seed": 42
    }
  },
  "evaluation": {
    "metrics": ["silhouette", "clusterSizes", "noiseFraction"],
    "sampleSize": 10000,
    "seed": 42
  },
  "sparkConf": {
    "spark.serializer": "org.apache.spark.serializer.KryoSerializer"
  }
}